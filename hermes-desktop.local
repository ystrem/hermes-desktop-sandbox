# Firejail profile for Hermes Agent Desktop (Electron)
# ~/.config/firejail/hermes-desktop.local

# --- Capabilities ---
caps.drop all

# --- Network ---
# Restrict to specific IPs via netfilter (passed via launcher)
protocol unix,inet,inet6





# --- Filesystem ---
# Private /tmp (fresh tmpfs each run)
private-tmp

# Home: read-only by default, whitelist what Hermes needs
read-only ${HOME}
read-write ${HOME}/.hermes
read-write ${HOME}/.local/share

# Electron app data & user config
read-write ${HOME}/.config/Hermes
read-write ${HOME}/.config/hermes-desktop
read-write ${HOME}/.config/Hermes Desktop
read-write ${HOME}/.config/hermes
read-write ${HOME}/.config/kbuildsycoca6rc
read-write ${HOME}/.config/kdeglobals
read-write ${HOME}/.cache/Hermes
read-write ${HOME}/.cache/hermes




# PulseAudio / PipeWire (for microphone + audio)
read-write ${HOME}/.config/pulse
read-write ${HOME}/.config/pipewire
read-write ${HOME}/.config/alsa
read-only $XDG_RUNTIME_DIR/pulse
read-only $XDG_RUNTIME_DIR/pipewire-0

# Block sensitive paths entirely
blacklist ${HOME}/.ssh
blacklist ${HOME}/.gnupg
blacklist ${HOME}/.password-store
blacklist ${HOME}/.config/1Password
blacklist ${HOME}/.config/Bitwarden
blacklist ${HOME}/.config/KeePassXC
blacklist ${HOME}/.config/chromium
blacklist ${HOME}/.config/google-chrome
blacklist ${HOME}/.config/BraveSoftware
blacklist ${HOME}/.config/microsoft-edge
blacklist ${HOME}/.config/mozilla
blacklist ${HOME}/.mozilla
blacklist ${HOME}/.config/opera
blacklist ${HOME}/.config/Vivaldi
blacklist ${HOME}/.bash_history
blacklist ${HOME}/.zsh_history
blacklist ${HOME}/.fish_history
blacklist ${HOME}/.python_history
blacklist ${HOME}/.lesshst
blacklist ${HOME}/.mysql_history
blacklist ${HOME}/.psql_history
blacklist ${HOME}/.config/gh
blacklist ${HOME}/.aws
blacklist ${HOME}/.azure
blacklist ${HOME}/.kube
blacklist ${HOME}/.config/gcloud
blacklist ${HOME}/.vault-token
blacklist ${HOME}/.boto
blacklist ${HOME}/.netrc
blacklist ${HOME}/.docker
blacklist ${HOME}/.docker/config.json
blacklist ${HOME}/.git-credentials*
blacklist ${HOME}/.npmrc
blacklist ${HOME}/.pypirc
blacklist ${HOME}/.cargo/credentials*

# --- Devices ---
nodvd
nou2f

# Allow audio (microphone for dictation)
# Remove 'nogroups' so /dev/snd is accessible
# nogroups

# --- Kernel security ---
seccomp
noroot
no3d
notv


# --- D-Bus ---
# Remove if you want system tray / notifications
# nodbus       # commented out — needed for PulseAudio/PipeWire
# nodbus-user  # commented out — needed for PulseAudio/PipeWire

# --- Remounts ---
disable-mnt



