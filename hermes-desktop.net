# Allow loopback (both outbound and inbound)
-A OUTPUT -o lo -j ACCEPT
-A INPUT -i lo -j ACCEPT

# Allow established/related connections (responses to our outbound connections)
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A OUTPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT


# === Local network ===
# Gateway — communicates with Hermes gateway on the same machine
-A OUTPUT -d 127.0.0.1/32 -j ACCEPT
-A OUTPUT -d ::1/128 -j ACCEPT

# === Local network / Remote Gateway ===
# Set your private gateway IP in hermes-desktop.net.local (gitignored)
# Example:
# -A OUTPUT -d 192.168.1.100/32 -j ACCEPT

# Drop everything else
-A OUTPUT -j REJECT
-A INPUT -j DROP





